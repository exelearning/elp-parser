{
    "name": "exelearning/elp-parser",
    "description": "Parse eXeLearning .elp and .elpx files",
    "keywords": [
        "exelearning",
        "elp",
        "elpx",
        "parser"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "INTEF",
            "email": "cedec@educacion.gob.es",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.0",
        "ext-simplexml": "*",
        "ext-zip": "*"
    },
    "suggest": {
        "ext-dom": "Required for optional XSD/DTD schema validation"
    },
    "require-dev": {
        "pestphp/pest": "^1.23 || ^2.36 || ^3.8 || ^4.7 || ^5.2",
        "phpstan/phpstan": "^2.2",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Exelearning\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Exelearning\\ElpParser\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/elp-parser"
    ],
    "scripts": {
        "test": "vendor/bin/pest",
        "test:coverage": "vendor/bin/pest --coverage --coverage-clover coverage.xml --min=90",
        "lint": "phpcs . --ignore=vendor/,assets/,node_modules/,tests/js/ --colors --warning-severity=0 --extensions=php",
        "fix": "phpcbf . --ignore=vendor/,assets/,node_modules/,tests/js/ --colors --warning-severity=0 --extensions=php",
        "analyse": "phpstan analyse --no-progress"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "archive": {
        "exclude": [
            "tests",
            "README.md",
            "examples",
            ".github",
            ".git",
            "test.php",
            "vendor"
        ]
    }
}
