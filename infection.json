{
  "$schema": "https://raw.githubusercontent.com/infection/infection/0.35.4/resources/schema.json",
  "timeout": 20,
  "threads": "max",
  "source": {
    "directories": [
      "src"
    ]
  },
  "logs": {
    "github": true,
    "summaryJson": "infection-summary.json"
  },
  "phpUnit": {
    "configDir": ".",
    "customPath": "vendor/bin/pest"
  },
  "ignoreMsiWithNoMutations": true,
  "minMsi": 75,
  "minCoveredMsi": 85,
  "maxTimeouts": 0,
  "mutators": {
    "@default": true
  }
}
